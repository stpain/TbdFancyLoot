<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

    <!-- Options UI Checkbox -->
    <CheckButton name="MinimalCheckboxArtTemplate" virtual="true">
		<NormalTexture parentKey="NormalTexture" atlas="checkbox-minimal" useAtlasSize="true"/>
		<PushedTexture parentKey="PushedTexture" atlas="checkbox-minimal" useAtlasSize="true"/>
		<HighlightTexture parentKey="HighlightTexture" atlas="checkbox-minimal" useAtlasSize="true" alphaMode="ADD"/>
		<CheckedTexture parentKey="CheckedTexture" atlas="checkmark-minimal" useAtlasSize="true"/>
		<DisabledCheckedTexture parentKey="DisabledCheckedTexture" atlas="checkmark-minimal-disabled" useAtlasSize="true"/>
	</CheckButton>
	<CheckButton name="MinimalCheckboxTemplate" inherits="MinimalCheckboxArtTemplate" virtual="true">
		<Size x="30" y="29"/>
	</CheckButton>

    <!-- Options UI Whitelist/Blacklist list item template -->
    <Frame name="TbdFancyLootListItemTemplate" virtual="true" enableMouse="true">
        <Size y="22"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" atlas="uitools-row-background-01" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT" x="-25"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Icon">
                    <Size x="20" y="20"/>
                    <!-- <TexCoords left="0.05" right="0.95" top="0.05" bottom="0.95"/> -->
                    <Anchors>
                        <Anchor point="LEFT"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Label" inherits="GameFontnormal">
                    <!-- <Size x="300" y="22"/> -->
                    <Anchors>
                        <Anchor point="LEFT" x="24" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="HIGHLIGHT">
                <Texture parentKey="Hover" atlas="uitools-row-background-hover">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT" x="-25"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Button parentKey="Delete">
                <NormalTexture atlas="common-icon-redx"/>
                <!-- <PushedTexture atlas="128-RedButton-Delete-Pressed"/>
                <HighlightTexture atlas="128-RedButton-Delete-Highlight"/> -->
                <Size x="20" y="20"/>
                <Anchors>
                    <Anchor point="RIGHT" x="-25" y="0"/>
                </Anchors>
            </Button>
        </Frames>
    </Frame>
    


    <!-- Loot frame item templates -->
    <Frame name="TbdFancyLootPersonalLootFancyItemTemplate" mixin="TbdFancyLootPersonalLootItemMixin" virtual="true">
        <Size x="80" y="80"/>
        <Layers>
            <Layer level="BACKGROUND">
                
            </Layer>
            <Layer level="ARTWORK">

            </Layer>
            <Layer level="OVERLAY">

            </Layer>
        </Layers>
    </Frame>

    <Frame name="TbdFancyLootPersonalLootItemTemplate" mixin="TbdFancyLootPersonalLootItemMixin" enableMouse="true" virtual="true">
        <Size x="276" y="80"/>
        <Layers>
            <Layer level="BACKGROUND">
                <!-- <Texture parentKey="Background" atlas="LootToast-LessAwesome"> -->
                <Texture parentKey="Background" atlas="recipetoast-bg">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="0" y="0"/>
                        <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="-1">
                <Texture parentKey="Icon">
                    <TexCoords left="0.04" right="0.96" top="0.04" bottom="0.96"/>
                    <Size x="54" y="54"/>
                    <Anchors>
                        <Anchor point="LEFT" x="17" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="IconBorder" atlas="charactercreate-ring-metallight" hidden="true">
                    <Size x="94" y="94"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.Icon" relativePoint="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="IconGlass" file="Interface/AddOns/TbdFancyLoot/GlassMask">
                    <Size x="54" y="54"/>
                    <TexCoords left="0.0" right="0.71875" top="0.0" bottom="0.71875"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.Icon" relativePoint="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="RightIcon">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="TOPRIGHT" x="-3" y="-3"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Label" inherits="GameFontWhite" justifyH="LEFT" justifyV="TOP">
                    <Size x="160" y="36"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="6" y="7"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemClassLabel" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="BOTTOM">
                    <Size x="200" y="18"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="TOPRIGHT" x="8" y="7"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemVendorPriceLabel" inherits="GameFontNormalSmall" justifyH="RIGHT">
                    <!-- <Size x="140" y="18"/> -->
                    <Color r="1" g="1" b="1"/>
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-20" y="12"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
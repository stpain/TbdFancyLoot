<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
https://raw.githubusercontent.com/Meorawr/wow-ui-schema/main/UI.xsd">

    <Frame name="TbdFancyLootPersonalLootFancyItemTemplate" virtual="true">
        <Size x="80" y="80"/>
        <Layers>
            <Layer level="BACKGROUND">
                
            </Layer>
            <Layer level="ARTWORK">

            </Layer>
            <Layer level="OVERLAY">

            </Layer>
        </Layers>
    </Frame>

    <Frame name="TbdFancyLootPersonalLootItemTemplate" mixin="TbdFancyLootPersonalLootItemMixin" enableMouse="true" virtual="true">
        <Size x="276" y="80"/>
        <Layers>
            <Layer level="BACKGROUND">
                <!-- <Texture parentKey="Background" atlas="LootToast-LessAwesome"> -->
                <Texture parentKey="Background" atlas="recipetoast-bg">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="0" y="0"/>
                        <Anchor point="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BACKGROUND" textureSubLevel="-1">
                <Texture parentKey="Icon">
                    <TexCoords left="0.04" right="0.96" top="0.04" bottom="0.96"/>
                    <Size x="54" y="54"/>
                    <Anchors>
                        <Anchor point="LEFT" x="17" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="IconBorder" atlas="charactercreate-ring-metallight" hidden="true">
                    <Size x="94" y="94"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.Icon" relativePoint="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="IconGlass" file="Interface/AddOns/TbdFancyLoot/GlassMask">
                    <Size x="54" y="54"/>
                    <TexCoords left="0.0" right="0.71875" top="0.0" bottom="0.71875"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent.Icon" relativePoint="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
                <Texture parentKey="RightIcon">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="TOPRIGHT" x="-3" y="-3"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Label" inherits="GameFontWhite" justifyH="LEFT" justifyV="TOP">
                    <Size x="160" y="36"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="6" y="7"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemClassLabel" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="BOTTOM">
                    <Size x="200" y="18"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="TOPRIGHT" x="8" y="7"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemVendorPriceLabel" inherits="GameFontNormalSmall" justifyH="RIGHT">
                    <!-- <Size x="140" y="18"/> -->
                    <Color r="1" g="1" b="1"/>
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-20" y="12"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>



    <Frame name="TbdFancyLootPersonalLootWindow" mixin="TbdFancyLootPersonalLootMixin" parent="UIParent" enableMouse="true" movable="true" hidden="true">
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Size x="300" y="200"/>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <!-- <OnUpdate method="OnUpdate"/> -->
            <OnEvent method="OnEvent"/>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
        </Scripts>
    </Frame>


</Ui>